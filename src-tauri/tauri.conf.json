{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NeoModern",
  "version": "0.2.0",
  "identifier": "io.github.r0madeus.neomodern",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NeoModern",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
